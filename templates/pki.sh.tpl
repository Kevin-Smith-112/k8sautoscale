# ---------- Shared cluster PKI (generated by Terraform, see pki.tf) ----------
mkdir -p /etc/kubernetes/pki/etcd
umask 077
%{ for name, cert in certs ~}
cat >/etc/kubernetes/pki/${name}.crt <<'PEM'
${cert}
PEM
cat >/etc/kubernetes/pki/${name}.key <<'PEM'
${keys[name]}
PEM
%{ endfor ~}
cat >/etc/kubernetes/pki/sa.key <<'PEM'
${sa_key}
PEM
cat >/etc/kubernetes/pki/sa.pub <<'PEM'
${sa_pub}
PEM
umask 022
